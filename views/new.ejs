<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add New Shipment</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <h1>Add New Shipment</h1>
  <form action="/shipments" method="POST">
    <label for="trackingId">Tracking ID:</label>
    <input type="text" id="trackingId" name="trackingId" required><br><br>
    
    <label for="status">Status:</label>
    <input type="text" id="status" name="status" required><br><br>
    
    <label for="origin">Origin:</label>
    <input type="text" id="origin" name="origin"><br><br>
    
    <label for="destination">Destination:</label>
    <input type="text" id="destination" name="destination"><br><br>
    
    <button type="submit">Create Shipment</button>
  </form>
  <a href="/">Back to Shipments</a>
</body>
</html>